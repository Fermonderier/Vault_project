{
  "name": "liquidity-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "anchor build --no-idl && anchor test --skip-build",
    "dev": "vite app --host 127.0.0.1",
    "build:web": "vite build app",
    "devnet:create-mints": "node scripts/devnet/create-test-mints.mjs",
    "devnet:create-clmm-pool": "node scripts/devnet/create-clmm-pool.mjs",
    "lint": "prettier --check \"tests/*.ts\" \"app/**/*.{ts,css,html}\" \"scripts/devnet/*.mjs\" README.md docs/demo.md docs/devnet.md docs/ROADMAP.md",
    "typecheck": "tsc --noEmit",
    "idl:types": "anchor idl type idl/liquidity_vault.json --out idl/liquidity_vault.ts",
    "sync:program-id": "anchor keys sync && node scripts/sync-program-id.mjs && npm run idl:types"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "buffer": "^6.0.3",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/bn.js": "^5.1.6",
    "@types/mocha": "^10.0.10",
    "@raydium-io/raydium-sdk-v2": "0.2.85-alpha",
    "chai": "^4.5.0",
    "decimal.js": "^10.4.3",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
